{
  "manifest_version": 3,
  "name": "SYZOJ 提交监视器",
  "version": "1.0.0",
  "description": "在任意网页悬浮展示目标 SYZOJ OJ 指定用户的实时提交（状态 / 得分 / 提交人 / 题目）。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://in.7fa4.cn:8888/*",
    "https://jx.7fa4.cn:8888/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SYZOJ 提交监视器"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
